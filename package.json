{
  "name": "ghostwriter",
  "productName": "ghostwriter",
  "version": "1.0.0",
  "description": "A sleek, modern AI-powered script writing tool for content creators",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "node --require ts-node/register ./node_modules/.bin/electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "npm run rebuild"
  },
  "keywords": [
    "electron",
    "ai",
    "markdown",
    "script",
    "writing",
    "content",
    "youtube",
    "tiktok"
  ],
  "author": {
    "name": "bootoshi",
    "email": "127834715+kingbootoshi@users.noreply.github.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.0",
    "@electron-forge/maker-deb": "^7.8.0",
    "@electron-forge/maker-rpm": "^7.8.0",
    "@electron-forge/maker-squirrel": "^7.8.0",
    "@electron-forge/maker-zip": "^7.8.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.8.0",
    "@electron-forge/plugin-fuses": "^7.8.0",
    "@electron-forge/plugin-vite": "^7.8.0",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.6.0",
    "@tailwindcss/postcss": "^4.1.3",
    "@tailwindcss/typography": "^0.5.16",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "autoprefixer": "^10.4.21",
    "electron": "35.1.5",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.31.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^5.4.18"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.2",
    "@tailwindcss/cli": "^4.1.3",
    "@tailwindcss/vite": "^4.1.3",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.2",
    "@types/uuid": "^10.0.0",
    "axios": "^1.8.4",
    "better-sqlite3": "^11.9.1",
    "codemirror": "^6.0.1",
    "dotenv": "^16.5.0",
    "electron-squirrel-startup": "^1.0.1",
    "marked": "^15.0.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uuid": "^11.1.0"
  }
}
